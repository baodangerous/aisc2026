rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function platformAdmin() {
      return request.auth != null && (request.auth.token.get('role', '') == 'platform_admin' || request.auth.token.get('admin', false) == true);
    }
    // All writes use the validated server API. Clients cannot forge metrics, reviews or audit records.
    match /users/{uid} {
      allow read: if owner(uid) || platformAdmin();
      allow write: if false;
    }
    match /trainingSessions/{id} {
      allow read: if owner(resource.data.ownerUid) || platformAdmin();
      allow write: if false;
    }
    match /volunteerApplications/{id} {
      allow read: if owner(resource.data.userId) || platformAdmin();
      allow write: if false;
    }
    match /deletionRequests/{id} {
      allow read: if owner(resource.data.uid) || platformAdmin();
      allow write: if false;
    }
    match /auditLogs/{id} {
      allow read: if platformAdmin();
      allow write: if false;
    }
    match /aggregates/{id} {
      allow read: if platformAdmin();
      allow write: if false;
    }
    // Public facilities are filtered by source and verification metadata at the API boundary.
    match /facilities/{id} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
