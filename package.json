{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build && esbuild server/standalone.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/server.js --external:@google/genai --external:express --external:cors --external:dotenv --external:zod --external:ai --external:@vercel/oidc",
    "build:vercel": "vite build",
    "start": "node dist/server.js",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "data:generate-demo": "tsx scripts/generate-demo-dataset.ts",
    "data:generate-timeline": "tsx scripts/generate-incident-timeline.ts",
    "data:ingest": "tsx scripts/ingest-ai-dataset.ts",
    "data:ingest-timeline": "tsx scripts/ingest-incident-timeline.ts",
    "facilities:import-osm": "tsx scripts/import-osm-facilities.ts",
    "data:import-external": "tsx scripts/import-external-first-aid.ts",
    "data:evaluate-ai": "tsx scripts/evaluate-ai.ts"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.146",
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "^5.102.2",
    "@types/leaflet": "^1.9.22",
    "@vis.gl/react-google-maps": "^1.9.0",
    "@vitejs/plugin-react": "^5.0.4",
    "ai": "^7.0.142",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "swr": "^2.5.1",
    "uuid": "^14.0.2",
    "vite": "^6.2.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^11.0.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "mammoth": "^1.13.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.11"
  }
}
