rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Role verification strictly based on Firebase Custom Claims set by trusted server backend
    function hasClaimRole(role) {
      return isAuthenticated() && (
        request.auth.token.role == role ||
        (role == 'platform_admin' && request.auth.token.admin == true)
      );
    }

    function isPrivilegedStaff() {
      return hasClaimRole('clinical_reviewer') || hasClaimRole('org_admin') || hasClaimRole('platform_admin');
    }

    // 1. Users collection: Strict owner-only read/write with field-level immutability
    match /users/{userId} {
      allow read: if isOwner(userId) || isPrivilegedStaff();
      
      // On creation, client cannot assign privileged roles
      allow create: if isOwner(userId) && (
        !('role' in request.resource.data) ||
        request.resource.data.role == 'citizen' ||
        request.resource.data.role == 'guest'
      );

      // On update, client can only update safe profile fields, never role, orgId, or verification status
      allow update: if isOwner(userId) && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role',
          'uid',
          'orgId',
          'createdAt',
          'verificationStatus',
          'admin',
          'reviewedBy',
          'reviewerPermissions'
        ])
      ) || hasClaimRole('platform_admin');

      allow delete: if isOwner(userId) || hasClaimRole('platform_admin');
    }

    // 2. Training Sessions & Events (Owner or privileged staff only)
    match /trainingSessions/{sessionId} {
      allow read: if isAuthenticated() && (
        resource.data.ownerUid == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isPrivilegedStaff()
      );

      allow create: if isAuthenticated() && (
        request.resource.data.ownerUid == request.auth.uid ||
        request.resource.data.userId == request.auth.uid
      );

      allow update: if isAuthenticated() && (
        (
          (resource.data.ownerUid == request.auth.uid || resource.data.userId == request.auth.uid) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerUid', 'userId', 'sessionId', 'clientSessionId'])
        ) ||
        isPrivilegedStaff()
      );

      allow delete: if isAuthenticated() && (
        (resource.data.ownerUid == request.auth.uid || resource.data.userId == request.auth.uid) ||
        hasClaimRole('platform_admin')
      );
    }

    // 3. Daily / Scenario Aggregates (Read public/anon aggregates, write only server/admin)
    match /aggregates/{aggregateId} {
      allow read: if true;
      allow write: if hasClaimRole('platform_admin');
    }

    // 4. Facilities & AED Stations (Public directory read, write restricted to admin/coordinator)
    match /facilities/{facilityId} {
      allow read: if true;
      allow write: if isPrivilegedStaff();
    }

    // 5. Volunteer Applications (Privacy-protected)
    match /volunteerApplications/{applicationId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isPrivilegedStaff()
      );

      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;

      allow update: if isAuthenticated() && (
        (
          resource.data.userId == request.auth.uid &&
          request.resource.data.status in ['pending_review', 'suspended', 'withdrawn'] &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['reviewedBy', 'reviewedAt', 'reviewNote'])
        ) ||
        isPrivilegedStaff()
      );

      allow delete: if hasClaimRole('platform_admin');
    }

    // 6. Responder Profiles
    match /responderProfiles/{profileId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isPrivilegedStaff()
      );
      allow write: if isPrivilegedStaff();
    }

    // 7. Audit Logs
    match /auditLogs/{logId} {
      allow read: if hasClaimRole('platform_admin') || hasClaimRole('clinical_reviewer');
      allow write: if false; // Server-only via Firebase Admin SDK
    }

    // 8. Deletion Requests (GDPR / Decree 13)
    match /deletionRequests/{requestId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.uid == request.auth.uid ||
        hasClaimRole('platform_admin')
      );
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.uid == request.auth.uid
      );
      allow write: if hasClaimRole('platform_admin');
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

